#!
delete interfaces reth0 redundant-ether-options lacp active
delete interfaces reth0 redundant-ether-options lacp periodic fast
delete interfaces reth1 redundant-ether-options lacp active
delete interfaces reth1 redundant-ether-options lacp periodic fast

delete interfaces ge-0/0/0 gigether-options redundant-parent reth0
delete interfaces ge-7/0/0 gigether-options redundant-parent reth0
delete interfaces fab0 fabric-options member-interfaces ge-0/0/3
delete interfaces reth0 vlan-tagging
delete interfaces reth0 redundant-ether-options redundancy-group 1
delete interfaces reth0 unit 901 description Untrust
delete interfaces reth0 unit 901 vlan-id 901
delete interfaces reth0 unit 901 family inet address 192.168.1.1/30
delete interfaces reth1 vlan-tagging       
delete interfaces reth1 redundant-ether-options redundancy-group 2
delete interfaces reth1 unit 902 description Untrust
delete interfaces reth1 unit 902 vlan-id 902
delete interfaces reth1 unit 902 family inet address 192.168.2.1/30

delete protocols lldp interface all
set protocols lldp interface ge-0/0/0
set protocols lldp interface ge-0/0/1
set protocols lldp interface ge-7/0/0
set protocols lldp interface ge-7/0/1

set interfaces ge-0/0/0 unit 0 family inet
set interfaces ge-0/0/1 unit 0 family inet
set interfaces ge-7/0/0 unit 0 family inet
set interfaces ge-7/0/1 unit 0 family inet

delete interfaces ge-0/0/0 unit 0
delete interfaces ge-0/0/1 unit 0
delete interfaces ge-7/0/0 unit 0
delete interfaces ge-7/0/1 unit 0

set security zones security-zone trust interfaces ge-0/0/0.0
set security zones security-zone trust interfaces ge-0/0/1.0
set security zones security-zone trust interfaces ge-7/0/0.0
set security zones security-zone trust interfaces ge-7/0/1.0

#################################3
interface GigabitEthernet1/0/1
 description Link to SRX300 HA node0
 switchport mode trunk
 switchport trunk allowed vlan 901
 no shutdown
interface GigabitEthernet1/0/2
 description Link to SRX300 HA node1
 switchport mode trunk
 switchport trunk allowed vlan 901
 no shutdown
!

